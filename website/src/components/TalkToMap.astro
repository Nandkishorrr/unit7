---
// Section C: the Map. HTML nodes for crisp text at any width; real.ts measures them and draws the lines in one SVG.
const cols = [
  { label: 'Domains', groups: [
    { name: 'Hostinger', logo: 'hostinger', ratio: '1', nodes: [['d-ship', 'shipfast.example'], ['d-stag', 'api-staging.shipfast.example'], ['d-run', 'runclub.example']] },
    { name: 'Cloudflare', logo: 'cloudflare', ratio: '256/117', nodes: [['d-nest', 'nestly.example'], ['d-orbit', 'orbit.example']] },
  ] },
  { label: 'Apps', groups: [
    { name: 'vps-01', logo: 'hostinger', ratio: '1', nodes: [['a-nest', 'nestly · web'], ['a-api', 'shipfast · api'], ['a-stag', 'shipfast · api (staging)'], ['a-work', 'shipfast · api worker']] },
    { name: 'Vercel', logo: 'vercel', ratio: '256/222', nodes: [['a-orbit', 'orbit-web'], ['a-shop', 'nestly-shop']] },
  ] },
  { label: 'Data', groups: [
    { name: 'vps-01', logo: 'hostinger', ratio: '1', nodes: [['b-nest', 'nestly · db'], ['b-ship', 'shipfast · db'], ['b-stag', 'shipfast · db-staging']] },
    { name: 'Supabase', logo: 'supabase', ratio: '256/263', nodes: [['b-orbit', 'orbit-db']] },
  ] },
];
// Asked in this order so the story holds: it finds the gap, then you ask it to close it.
const qas = [
  { q: 'What needs a look?', a: "api-staging.shipfast.example points somewhere it shouldn't. Want me to point it at shipfast · api (staging)?", yes: 'Yes, go ahead', fx: 'look' },
  { q: 'Which sites have no database connected?', a: 'orbit-web uses Supabase but has no Supabase address set. Want me to connect it?', fx: 'missing' },
  { q: 'Connect orbit-web to my Supabase.', a: "Done. I set the address and key on orbit-web, redeployed it, and I'll keep them in sync.", fx: 'connect' },
  { q: 'What breaks if I delete shipfast · db?', a: "shipfast · api and shipfast · api worker use it, so they'd stop working. Its newest backup stays.", fx: 'delete' },
];
const list = [
  ['As many accounts as you have.', 'Two Hostinger logins, a Vercel team per client, one Cloudflare for everything. They all land on one Map.'],
  ['It wires things together.', 'Database to app, app to app, across providers. It sets the right settings on both sides and keeps them in sync.'],
  ["It notices what's missing.", 'A site using Supabase with no Supabase address set? It says so, and one click connects it.'],
  ['It changes keys without breaking anything.', 'The new key and the old one both work for a day. Then the old one stops.'],
  ['Clients too.', 'Group everything by client, see costs per client and share a status link.'],
];
---
<section class="tmap sec" id="map" data-mood="night">
  <div class="wrap">
    <p class="eyebrow">The Map</p>
    <h2 class="d1 tmap__h" data-wipe>Talk to <em>your Map.</em></h2>
    <p class="lede lede--wide tmap__sub">Connect Hostinger, Cloudflare, Vercel, Supabase and the rest, with as many accounts as you have. The Map joins them up, and your AI reads it before it touches anything.</p>

    <div class="tm">
      <div class="tm__map">
        <svg class="tm__svg" aria-hidden="true"></svg>
        <div class="tm__cols">
          {cols.map((c) => (
            <div class="tm__col">
              <h3 class="tm__label">{c.label}</h3>
              {c.groups.map((g) => (
                <div class="tm__g">
                  <p class="tm__gh"><svg class="lg" style={`aspect-ratio:${g.ratio}`} aria-hidden="true"><use href={`#l-${g.logo}`} /></svg>{g.name}</p>
                  <ul>
                    {g.nodes.map(([id, name]) => <li data-n={id}><span set:html={name.replace(/\./g, '<wbr>.')} /></li>)}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>
        <p class="tm__key"><span><i></i>Works</span><span><i class="bad"></i>Points elsewhere</span></p>
      </div>

      <div class="tm__chat">
        <div class="tm__log" aria-live="polite"></div>
        <ul class="tm__qs">
          {qas.map((x) => (
            <li>
              <button type="button" class="tm__q" data-fx={x.fx}>{x.q}</button>
              <p class="tm__a">{x.a}</p>
              {x.yes && <p class="tm__yes" hidden>{x.yes}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="mock-label tm__label2">Demo workspace. Talking to it needs a connected AI. The Map itself doesn't.</p>

    <dl class="specs__list tm__list">
      {list.map(([label, line]) => <div><dt class="d3">{label}</dt><dd>{line}</dd></div>)}
    </dl>
  </div>
</section>

<style is:global>
  .tmap__h { margin-top: 1.1rem; }
  .tmap__sub { margin-top: 1.5rem; }
  .tm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 23rem); gap: 1rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .tm__map { position: relative; padding: clamp(.75rem, 1.6vw, 1.5rem); border: 1px solid var(--line); border-radius: 26px; background-color: var(--ink-1); background-image: radial-gradient(rgb(255 255 255 / .05) 1px, transparent 1.2px); background-size: 22px 22px; }
  .tm__svg { display: none; }
  .js .tm__svg { display: block; position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .tm__cols { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, .98fr); gap: clamp(1rem, 4.2vw, 4.25rem); }
  .tm__label { margin-bottom: .55rem; font: 500 .6875rem/1.3 var(--mono); text-transform: uppercase; letter-spacing: .14em; color: var(--faint); }
  .tm__g { padding: .45rem; border: 1px solid var(--line-2); border-radius: 16px; background: rgb(23 23 27 / .86); }
  .tm__g + .tm__g { margin-top: clamp(.6rem, 1.3vw, 1.1rem); }
  .tm__gh { display: flex; align-items: center; gap: .4rem; padding: .15rem .35rem .4rem; font-size: clamp(.6875rem, .62rem + .22vw, .8125rem); font-weight: 600; }
  .tm__gh .lg { height: .95em; color: #F2F2F4; }
  .tm__g li { position: relative; display: flex; align-items: center; min-height: clamp(1.9rem, 2.7vw, 2.35rem); padding: .2rem .55rem; border-radius: 10px; background: var(--ink-1); font-size: clamp(.625rem, .54rem + .28vw, .8125rem); line-height: 1.15; overflow-wrap: anywhere; transition: background-color .3s, box-shadow .3s, color .3s; }
  .tm__g li + li { margin-top: .22rem; }
  .tm__g li.amber { background: rgb(251 191 36 / .15); box-shadow: inset 0 0 0 1px var(--warn); color: var(--warn); }
  .tm__g li.hot { background: rgb(248 113 113 / .13); box-shadow: inset 0 0 0 1px var(--bad); }
  .tm__g li.miss { box-shadow: inset 0 0 0 1px var(--warn); }
  .tm__g li.miss::after { content: 'missing'; margin-left: auto; padding: .05rem .4rem; border-radius: 999px; background: var(--warn); color: #2B1E00; font-size: .85em; font-weight: 600; }
  .tm__key { display: flex; gap: 1.1rem; margin-top: .85rem; color: var(--muted); font-size: .75rem; }
  .tm__key span { display: inline-flex; align-items: center; gap: .45rem; }
  .tm__key i { width: 1.4rem; height: 2px; background: var(--product-blue); }
  .tm__key i.bad { height: 0; border-top: 2px dashed var(--bad); background: none; }

  .tm-line { fill: none; stroke: #3A5FD9; stroke-width: 1.5; transition: stroke .3s, opacity .3s; }
  .tm-line.amber { stroke: var(--warn); stroke-width: 2; }
  .tm-line.bad { stroke: var(--bad); stroke-dasharray: 5 5; }
  .tm-line.bad.glow { stroke-width: 2.25; filter: drop-shadow(0 0 5px var(--bad)); }
  .tm-end { fill: none; stroke: var(--bad); stroke-width: 1.5; transition: opacity .3s; }
  .tm-draw { fill: none; stroke: var(--soft-blue); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .tm-pulse { fill: none; stroke: var(--lime); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: .4 99.6; stroke-dashoffset: 100; animation: tm-run var(--t, 5s) linear var(--d, 0s) infinite; }
  @keyframes tm-run { to { stroke-dashoffset: 0; } }

  .tm__chat { display: flex; flex-direction: column; gap: .75rem; padding: 1rem; border: 1px solid var(--line); border-radius: 26px; background: var(--ink-2); font-size: .9375rem; line-height: 1.42; }
  .tm__log { display: none; }
  .js .tm__log { display: flex; flex-direction: column; justify-content: flex-end; gap: .6rem; flex: 1; min-height: 12rem; }
  .tm__ub { align-self: flex-end; max-width: 92%; padding: .5rem .85rem; border-radius: 16px 16px 4px 16px; background: #F2F2F4; color: #0E0E12; }
  .tm__ans { color: var(--text); }
  .tm__ans .w { opacity: 0; }
  .tm__go { align-self: flex-start; min-height: 2.5rem; padding: 0 1.1rem; border: 0; border-radius: 999px; background: var(--product-blue); color: #fff; font-weight: 600; cursor: pointer; transition: transform .15s, background-color .2s; }
  .tm__go:hover { background: #4A7BFF; }
  .tm__go:active, .tm__go.press { transform: scale(.94); }
  .tm__go:focus-visible { outline-color: #fff; }
  .tm__qs { display: grid; gap: .45rem; }
  .js .tm__a, .js .tm__yes { display: none; }
  .tm__a { margin-top: .3rem; color: var(--muted); }
  html:not(.js) .tm__q { font-weight: 600; }
  .tm__q { display: block; width: 100%; padding: .55rem .8rem; border: 1px solid var(--line-2); border-radius: 13px; background: none; color: var(--text); font-size: .875rem; line-height: 1.25; text-align: left; cursor: pointer; transition: background-color .2s, border-color .2s; }
  html:not(.js) .tm__q { border: 0; padding: 0; cursor: default; }
  .tm__q:hover { background: var(--line); }
  .tm__q[aria-pressed='true'] { border-color: var(--lime); }
  .tm__label2 { margin-top: .9rem; }
  .tm__list { margin-top: clamp(3rem, 6vw, 5rem); }
  @media (max-width: 1099px) { .tm { grid-template-columns: 1fr; } .js .tm__log { min-height: 10.5rem; } }
  @media (max-width: 899px) {
    .tm__cols { gap: .95rem; }
    .tm__g { padding: .25rem; border-radius: 12px; }
    .tm__gh { padding: .15rem .2rem .3rem; }
    .tm__g li { padding: .2rem .3rem; border-radius: 7px; }
    .tm__g li.miss::after { position: absolute; right: .15rem; top: -.5rem; }
  }
</style>
