---
import '../styles/global.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import archivoItalic from '@fontsource-variable/archivo/files/archivo-latin-wdth-italic.woff2?url';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { SITE_URL, REPO_URL, SIGNULL_URL, LATEST, UPDATES_FORM } from '../site';

interface Props { title: string; description: string; theme?: 'night' | 'dawn' | 'day'; noindex?: boolean; }
const { title, description, theme = 'night', noindex = false } = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).href;
const og = new URL('/og.png', SITE_URL).href;
const links = [['Product', '/'], [LATEST, '/v2/'], ['Open source', '/open-source/']];
const current = (href: string) => (path.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : undefined);
const ld = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Unit 7',
  applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Linux', softwareVersion: '2.1', url: SITE_URL,
  description: 'A free, open-source control room for your servers, apps, domains, databases and backups.',
  license: 'https://www.apache.org/licenses/LICENSE-2.0', codeRepository: REPO_URL, isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Signull', url: SIGNULL_URL },
};
---
<!doctype html>
<html lang="en" data-page={theme} data-theme={theme === 'day' ? 'day' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#050506" />
  <meta name="color-scheme" content={theme === 'day' ? 'light' : 'dark'} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Unit 7 by Signull" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Unit 7 mark and the line: The backend developer your AI coding agent never had." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={archivoItalic} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  <script is:inline>
    (function () {
      var d = document.documentElement, paused = false;
      d.classList.add('js');
      try { paused = sessionStorage.getItem('u7-paused') === '1'; } catch (e) {}
      if (paused) d.classList.add('paused');
      if (!paused && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      // If the script never runs, nothing stays hidden.
      setTimeout(function () { if (!window.__u7) d.classList.remove('motion'); }, 4000);
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <canvas id="gl" aria-hidden="true"></canvas>

  <header class="nav" id="nav">
    <a class="nav__brand" href="/" aria-label="Unit 7 by Signull, home">
      <img src="/brand/unit7-mark.svg" width="30" height="30" alt="" />
      <span class="nav__name">Unit 7</span>
      <span class="nav__by"><img src={theme === 'day' ? '/brand/signull-mark-ink.svg' : '/brand/signull-mark-lime.svg'} width="12" height="12" alt="" />by Signull</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      {links.map(([label, href]) => <a href={href} aria-current={current(href)}>{label}</a>)}
    </nav>
    <a class="nav__gh" href={REPO_URL} rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
      GitHub
    </a>
    <details class="nav__menu">
      <summary>Menu</summary>
      <div>
        {links.map(([label, href]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        <a href={REPO_URL} rel="noopener">GitHub</a>
      </div>
    </details>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot ink" data-opaque>
    <div class="wrap">
      <div class="foot__top">
        <div>
          <a class="foot__sig" href={SIGNULL_URL} rel="noopener"><img src="/brand/signull-lockup-on-dark.svg" width="1141" height="304" alt="Signull" /></a>
        </div>
        <div>
          <h2>Product</h2>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/v2/">{LATEST}</a></li>
            <li><a href="/open-source/">Open source</a></li>
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
            <li><a href={`${REPO_URL}/issues`} rel="noopener">Issues</a></li>
            <li><a href={`${REPO_URL}/security`} rel="noopener">Security</a></li>
            <li><a href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">Licence</a></li>
          </ul>
        </div>
        <div>
          <h2>Signull</h2>
          <ul><li><a href={SIGNULL_URL} rel="noopener">signull.in</a></li></ul>
        </div>
      </div>
      <div class="foot__print small">
        <p>© 2026 Signull. Unit 7 is open source under the Apache License 2.0.</p>
        <p>Screens show a demo workspace. Every name, domain and IP is made up. Trademarks belong to their owners.</p>
        <p>Visits are counted with Vercel Web Analytics, with no tracking cookies.{UPDATES_FORM && ' Email addresses are kept in Kit and used only for Unit 7 updates.'}</p>
      </div>
    </div>
    <span class="foot__word" aria-hidden="true">Unit 7</span>
  </footer>

  <aside class="warden" id="warden" hidden aria-label="Warden, the Unit 7 mascot">
    <p class="warden__say" role="status" hidden></p>
    <div class="warden__face">
      <svg viewBox="0 0 48 48" aria-hidden="true" class="warden-face" style="--mood:#C6F432">
        <circle cx="24" cy="26" r="15" fill="#eef0f3" />
        <rect x="12.5" y="21.5" width="23" height="9.5" rx="4.75" fill="#0b0f19" />
        <g class="warden-look">
          <ellipse class="warden-glow" cx="19.5" cy="26.2" rx="4" ry="3.2" fill="var(--mood)" opacity=".25" />
          <ellipse class="warden-glow" cx="28.5" cy="26.2" rx="4" ry="3.2" fill="var(--mood)" opacity=".25" />
          <g class="warden-eyes">
            <circle cx="19.5" cy="26.2" r="2.1" fill="var(--mood)" />
            <circle cx="28.5" cy="26.2" r="2.1" fill="var(--mood)" />
          </g>
        </g>
        <path d="M10.5 17 Q24 3 37.5 17 L37.5 19.5 L10.5 19.5 Z" fill="#1f5bff" />
        <path d="M8.5 19.5 Q24 15.5 40 20 Q38.5 23 24 22 Q11 21.5 8.5 19.5 Z" fill="#0e0e12" />
        <circle cx="24" cy="12.5" r="2.2" fill="#c6f432" />
      </svg>
      <button class="warden__x" type="button" aria-label="Dismiss Warden">×</button>
    </div>
  </aside>

  <div class="pausenote" id="pausenote" role="status" hidden>
    <span>Paused. Nothing changes without you.</span>
    <button type="button" data-resume>Turn Autopilot back on</button>
  </div>

  <script src="../scripts/motion.ts"></script>
</body>
</html>
