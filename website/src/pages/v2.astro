---
import Base from '../layouts/Base.astro';
import Updates from '../components/Updates.astro';
import { REPO_URL } from '../site';

type S = 'Done' | 'In testing' | 'In progress';
// Every finished part of V2 uses this. Newer work carries its own status.
const BUILT: S = 'Done';
const status = (s: S) => `<span class="status ${{ Done: 'done', 'In testing': 'test', 'In progress': 'prog' }[s]}">${s}</span>`;

const rows: { now: string; name: string; line: string; s: S }[] = [
  { now: 'It only happens if someone writes a long prompt.', name: 'Check-up.', line: 'One button, or it runs by itself.', s: BUILT },
  { now: 'It stops when your computer sleeps.', name: 'Always on.', line: 'A small guard stays on the server.', s: BUILT },
  { now: 'Some numbers were wrong, and it never said what it skipped.', name: 'Truth pass.', line: "Real numbers, and every report says what wasn't checked.", s: 'Done' },
  { now: 'The result ends as text in a chat.', name: 'Give this to my AI.', line: 'Then Unit 7 proves the fix worked in production.', s: BUILT },
  { now: 'A backup fix marked "safe" just sits there.', name: 'Safety Net.', line: 'Anything that only creates or copies runs by itself.', s: BUILT },
];

const stats = [
  { n: '128', tail: 'of 131', line: 'critical "site down" alerts came from a Mac losing its connection, not from the sites.' },
  { n: '13', tail: 'of 13', line: '"error" alerts were normal lines with a word like "exceptions" in the URL.' },
  { n: '618', tail: 'MB', line: 'of a 748 MB database was one repeated call.' },
  { n: '59', tail: 'of 61', line: 'CPU and network alerts cleared by themselves within an hour.' },
];

// Example times, labelled as examples on the page.
const ladder = [
  ['Checks free disk and how busy the server is', '02:10:04'],
  ['Copies the database', '02:10:09'],
  ["Checks the copy isn't empty or damaged", '02:11:02'],
  ['Sends an encrypted copy off the server', '02:11:15'],
  ['Turns on daily copies', '02:13:40'],
  ["Copies uploaded files, settings and Coolify's config", '02:13:44'],
  ['Restores into a throwaway copy, counts the rows, removes the throwaway', '02:16:31'],
  ['Tells you', '02:19:08'],
];

const levels = [
  ['Unprotected', 'no copy anywhere'],
  ['Weak', 'copies, but only on this server'],
  ['Protected', 'a copy off the server'],
  ['Proven', 'that copy restored in a test this week'],
];

const bands = [
  { c: 'green', word: 'Green.', title: 'Only creates or copies.', eg: 'Backups, off-server copies, test restores.', who: 'Unit 7, by itself.' },
  { c: 'yellow', word: 'Yellow.', title: 'A reversible change.', eg: 'Restart, memory cap, closing a port.', who: 'Your autonomy level, with undo.' },
  { c: 'red', word: 'Red.', title: 'Can lose something, or costs money.', eg: 'Delete, cleanup, overwrite, restore over live data, DNS, spending.', who: 'Always a person.' },
];

const digest = [
  'Your site asks the same question every 5 seconds.',
  'Your page asks for the same thing twice in a row.',
  'One page makes 40 calls to fetch 40 items.',
  "Part of your app keeps asking for something it can't have.",
  'When your server struggled, your app called it over and over.',
  'Your app calls itself through the internet. It could stay inside the server.',
  'Each page asks the database the same small thing 40 times.',
  'This page downloads 2 MB every visit.',
];

// One tick per hour of a week. The laptop sleeps about ten hours a night: 70 of 168 is the measured 42%.
const week = Array.from({ length: 168 }, (_, i) => { const h = i % 24; return h >= 21 || h <= 6; });

const groups = [
  { title: 'Safer around your AI', items: [
    ['What did my AI do?', 'Every change each AI made, with undo.'],
    ['Seat belt for your AI.', 'A fresh copy before Claude Code runs a risky database command.'],
    ['Try it on a copy first.', 'Rehearses risky changes on a throwaway copy.'],
    ["Can't be tricked by logs.", 'Seven only proposes. Fixed code decides what runs, and a claim from a log can at most become a question.'],
  ] },
  { title: 'Deep security', items: [
    ['What can a stranger do?', 'Tests your own apps from outside, as nobody.'],
    ['Have I been hacked?', 'Looks for signs of a break-in.'],
    ['Fire drill.', 'Times a real restore on a throwaway copy.'],
    ['Database door rules.', 'Checks open tables and risky policies on self-hosted Supabase.'],
  ] },
  { title: 'For a bad day', items: [
    ["Help, something's wrong.", 'One button: safety copy, clear next step, customer message.'],
    ['Lifeboat.', 'Danger spotted? An emergency copy leaves the server.'],
    ['Open a past copy.', "Yesterday's data beside the live one. Pull back one table."],
    ['Telegram alerts.', 'Alerts and replies where you already are.'],
  ] },
];

const jobs = ['Is everything OK?', 'Why is it slow?', 'Reduce my server', 'What changed?', 'Have I been hacked?', 'Why did my bill go up?', 'Am I ready for real users?', 'Will my emails arrive?', 'Can Google see my site?', 'Prove my backups work', 'If this server died today?', 'Hand this project over'];

const limits: { verb: string; rest: string; s: S }[] = [
  { verb: 'checks', rest: 'everything by itself, every day. Most of this needs no AI.', s: BUILT },
  { verb: 'protects', rest: 'by itself. Anything that only creates or copies runs with no approval.', s: BUILT },
  { verb: 'explains', rest: 'what it found, and says "not sure" when it isn\'t.', s: BUILT },
  { verb: 'fixes safe things', rest: 'by itself, with undo, and proves they worked.', s: BUILT },
  { verb: 'proposes one fix', rest: 'for risky things, and you say yes.', s: BUILT },
];

const phases: { t: string; s: S; done: string; still?: string }[] = [
  { t: 'Truth pass.', s: 'Done', done: "the brief's numbers match reality, and a network drop on your computer raises no critical alert." },
  { t: 'Safety Net and Check-up.', s: 'In testing', done: 'every important database reaches Proven with no click and nothing existing changes.', still: 'test restores on full Supabase stacks.' },
  { t: 'Give this to my AI.', s: BUILT, done: 'a finding goes to Cursor in two clicks, and Unit 7 later says Fixed or Still happening by itself.' },
  { t: 'Call Inspector.', s: 'In testing', done: 'it finds real wasteful calls with few false alarms.', still: 'tuning on real traffic.' },
  { t: 'Always on.', s: 'In testing', done: 'no reading gap over 10 minutes for a week with the computer asleep.', still: 'a full week on a real server.' },
  { t: 'Smarter, safer agent: Seven.', s: 'In testing', done: 'automatic looks run on an API key inside a budget.', still: 'a first run on a real API key, and a first shift that acts on a real server.' },
  { t: 'Deep security.', s: BUILT, done: 'it tells you what a stranger can do on your real apps.' },
  { t: 'Ready for everyone.', s: 'In testing', done: 'a stranger installs it in one command and tries it in 5 minutes.', still: 'scoped server access, and a first full run of the installer.' },
];

const sevenRules = [
  ['It looks every 6 hours.', "A deeper review once a day, and right after a failed deploy, a serious alert or a fix that didn't hold."],
  ['Alone, it only creates or copies.', 'Backups, tests of them, swap and a renewed certificate. Fixed code decides that, not the AI.'],
  ['Everything else is a question.', 'Restarts, memory caps, blocks and clean-ups wait for your yes, unless you taught it that fix.'],
  ['Told no means no.', 'For 30 days. Pause stops it, and so does its own switch, which only a person can use.'],
];

const fresh = [
  ['Put this live.', 'Drop a folder or a ZIP, or pick a GitHub repo. It picks the best host you have connected, from 16, including Vercel, Netlify, Cloudflare Pages, Coolify and your own server.'],
  ['Your real databases.', 'Tables, safe queries, import and export on any Postgres, MySQL, MariaDB, Redis or MongoDB it finds on your server, Supabase included. Personal columns stay hidden from an AI.'],
  ['Supabase and Neon.', 'Projects, SQL, functions, secrets, auth, storage and logs, hosted or self-hosted.'],
  ['Domains and DNS.', 'Records, redirects, wildcards and one-step domains on Coolify apps. Mail records wait for a person.'],
  ['Files.', 'Browse, edit, upload and download on a server. A removed file waits 7 days in a trash.'],
  ['Server care.', 'Snapshots, ports, SSH keys, users and moving to a new server. Buying and deleting stay with a person.'],
  ['WordPress.', 'Sites on your server. A broken site? It finds the plugin and offers to switch it off.'],
  ['Coolify, with no setup.', 'Its servers, apps and projects, plus deploy on push, previews, storage and scaling.'],
  ['One-click tools.', 'More than 30 open-source tools, with the admin login claimed first, and any Coolify template one search away.'],
];

const wont = [
  ['A coding agent.', 'You already have one.'],
  ['An AI model.', 'Bring your own.'],
  ['Multi-agent swarms.', ''],
  ['Percent-confidence scores.', "Nothing shows they're calibrated."],
  ['A hosted cloud holding your root keys.', ''],
  ['Restoring over live data by itself.', 'That always waits for a person.'],
];
---
<Base title="Unit 7 V2.1: already done when you open the app" description="V1 does the job when you ask. V2 has already done it when you open the app. V2.1 adds Seven, an agent on shift. An honest status on every part." theme="dawn">
  <section class="vh" data-mood="dawn" data-power=".7">
    <div class="wrap vh__in">
      <p class="vh__pill" data-intro><i></i>V2.1 is the latest version.</p>
      <h1 class="d1" data-intro>V1 does the job when you ask. <em>V2 has already done it when you open the app.</em></h1>
      <p class="lede lede--wide" data-intro>It checks by itself, protects by itself and proves its fixes, while you get on with building. V2.1 adds Seven, an agent on shift.</p>
      <p class="small" data-intro>Each part below says where it stands. No dates, no promises we can't keep.</p>
    </div>
  </section>

  <section class="sev sec" id="seven" data-mood="dawn">
    <div class="wrap">
      <Fragment set:html={status('In testing')} />
      <h2 class="d1 vs" data-wipe>Seven. <em>The agent on shift.</em></h2>
      <p class="lede lede--wide sev__sub">New in V2.1. There's no chat box. It looks at everything, does the safe work and asks one clear question when it must. When nothing has changed, it spends nothing and says nothing.</p>
      <div class="sev__grid">
        <ul class="sev__rules">
          {sevenRules.map(([a, b]) => <li><b>{a}</b> {b}</li>)}
        </ul>
        <figure class="sevm">
          <header><b>Seven</b><span><i></i>On shift</span></header>
          <p class="sevm__calm">Nothing needs you. I looked 12 minutes ago.</p>
          <h3>Should I?</h3>
          <div class="sevm__q">
            <p>Give Demo CRM a memory cap of 768 MB?</p>
            <small>It has no limit, so one leak could take your other apps down. Nothing restarts. You can undo it.</small>
            <div aria-hidden="true"><span class="cum__btn cum__btn--blue">Yes, do it</span><span class="cum__btn">No</span></div>
          </div>
          <h3>Done for you</h3>
          <p class="sevm__done"><time>03:12</time>Copied Demo Postgres off the server and proved it restores</p>
          <p class="sevm__done"><time>08:05</time>Renewed the certificate for nestly.example</p>
        </figure>
      </div>
      <p class="mock-label sev__label">Demo workspace. Numbers are examples.</p>
      <p class="small sev__note">Routine shifts use fixed rules until you connect an API key or a local model. With one, each shift stays inside a daily budget, $1 by default.</p>
    </div>
  </section>

  <section class="nw sec" id="new" data-mood="night">
    <div class="wrap">
      <h2 class="d2" data-wipe>New since V2.1. <em>Now it can start things too.</em></h2>
      <p class="lede lede--wide nw__sub">It used to look after what already exists. These are the jobs people need in their first week.</p>
      <ul class="nw__list">
        {fresh.map(([name, line]) => (
          <li><p><b>{name}</b> {line}</p><Fragment set:html={status('In testing')} /></li>
        ))}
      </ul>
      <p class="small nw__note">All of this is built and tested against fake servers. First runs on real accounts come next.</p>
    </div>
  </section>

  <section class="vt sec" data-mood="night">
    <div class="wrap">
      <h2 class="d2" data-wipe>V1 and <em>V2.</em></h2>
      <div class="vt__labels mono" aria-hidden="true"><span>V1</span><span>V2</span></div>
      <ul class="vt__rows">
        {rows.map((r) => (
          <li class="vt__row">
            <p class="vt__now"><span class="sr">V1: </span><span class="vt__txt" data-t={r.now}>{r.now}</span></p>
            <i class="vt__slash" aria-hidden="true"></i>
            <div class="vt__next">
              <p><span class="sr">V2: </span><b>{r.name}</b> {r.line}</p>
              <Fragment set:html={status(r.s)} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="vtr sec" data-mood="alert">
    <div class="wrap">
      <Fragment set:html={status('Done')} />
      <h2 class="d2 vs" data-wipe>First we checked our own numbers. <em>Many were wrong.</em></h2>
      <p class="lede lede--wide vtr__sub">Measured on a real install. So this came first, before anything new.</p>
      <ul class="vtr__stats">
        {stats.map((s) => (
          <li>
            <p class="vtr__n num"><span data-count={s.n}>{s.n}</span> <small>{s.tail}</small></p>
            <p class="vtr__line">{s.line}</p>
          </li>
        ))}
      </ul>
      <p class="vtr__end lede lede--wide">Now it asks a neutral site and the server itself before it alerts, says when it wasn't watching, and says how many apps each report really covered.</p>
    </div>
  </section>

  <section class="net" id="safety-net" data-mood="safe" data-warden="I made a copy. Nothing else changed.">
    <div class="net__stage">
      <div class="wrap net__in">
        <div class="net__head">
          <Fragment set:html={status(BUILT)} />
          <h2 class="d2 vs">If it matters and has no safe copy, <em>Unit 7 makes one.</em></h2>
          <p class="lede lede--wide">It doesn't suggest a backup and wait. It makes one, proves it works and tells you in one line.</p>
        </div>
        <div class="net__grid">
          <div>
            <ol class="ladder">
              {ladder.map(([step, time]) => (
                <li>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3.5 8.5 6.6 11.6 12.5 5" /></svg>
                  <span>{step}</span>
                  <time>{time}</time>
                </li>
              ))}
            </ol>
            <p class="net__label mono">Demo workspace. Numbers are examples.</p>
          </div>
          <div class="net__right">
            <ol class="meter">
              {levels.map(([name, line], i) => (
                <li style={`--h:${25 * (i + 1)}%`}>
                  <span class="meter__bar" aria-hidden="true"><i></i></span>
                  <b>{name}</b>
                  <span class="meter__line">{line}</span>
                </li>
              ))}
            </ol>
            <div class="net__says">
              <svg viewBox="0 0 48 48" aria-hidden="true" class="warden-face" style="--mood:#C6F432">
                <circle cx="24" cy="26" r="15" fill="#eef0f3" />
                <rect x="12.5" y="21.5" width="23" height="9.5" rx="4.75" fill="#0b0f19" />
                <g class="warden-eyes"><circle cx="19.5" cy="26.2" r="2.1" fill="var(--mood)" /><circle cx="28.5" cy="26.2" r="2.1" fill="var(--mood)" /></g>
                <path d="M10.5 17 Q24 3 37.5 17 L37.5 19.5 L10.5 19.5 Z" fill="#1f5bff" />
                <path d="M8.5 19.5 Q24 15.5 40 20 Q38.5 23 24 22 Q11 21.5 8.5 19.5 Z" fill="#0e0e12" />
                <circle cx="24" cy="12.5" r="2.2" fill="#c6f432" />
              </svg>
              <p>nestly had no safe copy. I made one and proved it. Nothing else changed.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bands sec" data-mood="deep">
    <div class="wrap">
      <ul class="bands__list">
        {bands.map((b) => (
          <li class={`band band--${b.c}`}>
            <h3 class="d3"><span>{b.word}</span> {b.title}</h3>
            <p class="band__eg">{b.eg}</p>
            <p class="band__who"><span class="mono">Who decides:</span> {b.who}</p>
          </li>
        ))}
      </ul>
      <p class="bands__note small">Green actions need no AI. Fixed rules run them, so nothing in a log can talk it into anything.</p>
    </div>
  </section>

  <section class="cu sec" data-mood="night">
    <div class="wrap">
      <Fragment set:html={status(BUILT)} />
      <h2 class="d2 vs" data-wipe>Your whole setup. <em>One tap. About a minute.</em></h2>
      <p class="lede lede--wide cu__sub">Room, protection, safety and how your apps behave. It works with no AI and costs nothing. A connected AI adds the explanation.</p>

      <figure class="cum">
        <header class="cum__top">
          <p>Check-up · everything · 58 seconds ago</p>
          <span class="cum__btn" aria-hidden="true">Run again</span>
        </header>
        <div class="cum__verdict">
          <p class="cum__big">Healthy. Nothing urgent. 3 things worth doing.</p>
          <p class="cum__since">Since last time: 2 fixed · 1 new · 3 the same</p>
        </div>
        <ul class="cum__tiles">
          <li><h3>Room</h3><p class="cum__v">Plenty</p><p>RAM <span data-count="37" data-count-manual>37</span>%, peak <span data-count="54" data-count-manual>54</span>%</p></li>
          <li><h3>Protection</h3><p class="cum__v"><span data-count="3" data-count-manual>3</span> of 4 proven</p><p>Last copy 02:10</p></li>
          <li><h3>Safety</h3><p class="cum__v"><span data-count="1" data-count-manual>1</span> thing to do</p><p>No open doors</p></li>
          <li><h3>App behaviour</h3><p class="cum__v"><span data-count="4" data-count-manual>4</span> wasteful calls</p><p><span data-count="1400" data-count-manual>1,400</span> extra calls a day</p></li>
        </ul>
        <p class="cum__cover"><span>Checked 23 of 27 · 4 skipped: Coolify log access</span><span class="cum__btn" aria-hidden="true">Give access</span></p>
        <div class="cum__block">
          <h3>Done for you</h3>
          <p>Copied 3 databases off the server and proved they restore. Nothing else changed.</p>
        </div>
        <div class="cum__block">
          <h3>Do these first</h3>
          <ol class="cum__todo">
            <li><span>Your app asks "who is this user?" too often</span><b>Your AI</b><span class="cum__btn cum__btn--blue" aria-hidden="true">Give this to my AI</span></li>
            <li><span>An outside service refuses every call</span><b>Only you</b><span class="cum__btn" aria-hidden="true">Write my support ticket</span></li>
            <li><span>Choose where copies go</span><b>Only you</b><span class="cum__btn" aria-hidden="true">Choose a place</span></li>
          </ol>
        </div>
      </figure>
      <p class="cu__label">Demo workspace. Numbers are examples.</p>
    </div>
  </section>

  <section class="ai sec" data-mood="night">
    <div class="wrap">
      <Fragment set:html={status(BUILT)} />
      <h2 class="d2 vs" data-wipe>It finds the problem. Your AI fixes it. <em>Unit 7 proves it worked.</em></h2>
      <p class="lede lede--wide ai__sub">One button sends the evidence and a strong prompt to the AI that built your app. After your next deploy, Unit 7 measures again. Only Unit 7 can mark it fixed.</p>

      <ol class="rail">
        <li>Open</li>
        <li>Sent to my AI</li>
        <li>Deployed, watching</li>
        <li class="rail__fixed">Fixed</li>
        <li class="rail__alt">Still happening</li>
      </ol>
      <ul class="chips" aria-label="Where a finding can go">
        {['Copy', 'Cursor', 'Claude Code', 'Codex', 'Lovable', 'Claude on the web'].map((c) => <li>{c}</li>)}
      </ul>

      <div class="depth">
        <h3 class="d3">One finding, three depths.</h3>
        <div class="depth__tabs" role="tablist" aria-label="How deep to go">
          <button role="tab" id="t-vibe" aria-controls="p-vibe" aria-selected="true" type="button">Vibe coder</button>
          <button role="tab" id="t-normal" aria-controls="p-normal" aria-selected="false" type="button">Normal coder</button>
          <button role="tab" id="t-adv" aria-controls="p-adv" aria-selected="false" type="button">Advanced</button>
        </div>
        <div class="depth__panels">
          <div class="depth__p" role="tabpanel" id="p-vibe" aria-labelledby="t-vibe" tabindex="0">
            <p>Your app asks "who is this user?" far too often. That's 6,625 calls in 7 days for only a few people. It's wasted work, and it slows pages.</p>
            <div class="depth__btns" aria-hidden="true"><span class="cum__btn cum__btn--blue">Give this to my AI</span></div>
          </div>
          <div class="depth__p" role="tabpanel" id="p-normal" aria-labelledby="t-normal" tabindex="0">
            <p><code>GET /auth/v1/user</code>: 6,625 calls in 7 days, likely <code>getUser()</code> running on every route change. Search for <code>getUser(</code> and your middleware. Cache the session and check it once per interval.</p>
            <div class="depth__btns" aria-hidden="true"><span class="cum__btn cum__btn--blue">Open in Cursor</span><span class="cum__btn">GitHub issue</span></div>
          </div>
          <div class="depth__p" role="tabpanel" id="p-adv" aria-labelledby="t-adv" tabindex="0">
            <p>The route, counts per client, hourly chart, status split and the check Unit 7 will run after your deploy, as JSON, with exact commands.</p>
            <p class="depth__cmd"><code>unit7 finding auth-user-3f2a --json</code></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ci sec" data-mood="alert">
    <div class="wrap">
      <Fragment set:html={status('In testing')} />
      <h2 class="d2 vs" data-wipe>It finds the calls <em>nobody meant to make.</em></h2>
      <p class="lede lede--wide ci__sub">Repeated, wrong and wasteful calls, found in your proxy log and your database's own counters, with nothing to install.</p>
      <div class="ci__grid">
        <div class="logs" aria-label="The same call, GET /auth/v1/user, repeated 6,625 times, collapsed into one row." role="img">
          <div class="logs__stream" aria-hidden="true">
            {Array.from({ length: 11 }).map(() => <code>GET /auth/v1/user <b>200</b></code>)}
          </div>
          <p class="logs__one" aria-hidden="true"><code>GET /auth/v1/user <b>200</b></code><span class="num">× <span class="logs__count">6,625</span></span></p>
        </div>
        <ul class="ci__digest">
          {digest.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <p class="small ci__note">The first week is silent, so false alarms get caught before you ever see one.</p>
    </div>
  </section>

  <section class="on sec" data-mood="deep">
    <div class="wrap">
      <Fragment set:html={status(BUILT)} />
      <h2 class="d2 vs" data-wipe>Your laptop sleeps. <em>Your server shouldn't lose its guard.</em></h2>
      <p class="lede lede--wide on__sub">Outpost is one small, readable script on the server. It keeps measuring, takes scheduled copies and sends phone alerts by itself. No open port. One click to install or remove.</p>
      <div class="on__read">
        <p class="on__num num"><span class="on__pct">58</span>%</p>
        <p class="on__label"><span class="mono">Hours watched</span><span class="on__tag">measured</span></p>
      </div>
      <ul class="on__week" aria-label="One week, hour by hour. 42% of the hours are gaps where nothing was watching.">
        {week.map((gap) => <li class:list={[{ gap }]}></li>)}
      </ul>
      <p class="on__key mono"><span><i></i>Watched</span><span><i class="gap"></i>Not watching</span></p>
      <p class="small on__note">If the server and your computer both go silent, an outside heartbeat tells you.</p>
    </div>
  </section>

  <section class="els sec" data-mood="night">
    <div class="wrap">
      <h2 class="d2" data-wipe>Everything <em>else.</em></h2>
      <div class="els__groups">
        {groups.map((g) => (
          <div class="els__g">
            <h3 class="d3">{g.title}</h3>
            <ul>
              {g.items.map(([name, line, state]) => (
                <li><p><b>{name}</b> {line}</p><Fragment set:html={status((state ?? BUILT) as S)} /></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="jobs">
