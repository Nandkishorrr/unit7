  .step code { margin-left: auto; color: var(--faint); font-size: .8125rem; }
  .answer { margin-top: .85rem; font-size: 1rem; line-height: 1.6; }
  .answer code { padding: .1em .35em; border-radius: 6px; background: rgb(255 255 255 / .07); font-size: .85em; }
  .card { padding: 1rem 1.1rem; border-radius: 18px; background: var(--ink-3); }
  .card h4 { font-size: 1.0625rem; font-weight: 600; }
  .card__meta { color: var(--muted); font-size: .875rem; }
  .card dl { display: grid; gap: .35rem; margin-top: .7rem; font-size: .9375rem; }
