  .js .gate__routes li.on .gate__result { visibility: visible; }

  .gate__map { position: relative; margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .gate__svg { display: none; }
  .gate__nodes { display: grid; gap: .9rem; }
  .gate__txt b { display: block; font-weight: 600; font-size: 1rem; line-height: 1.2; }
  .gate__txt code { display: block; margin-top: .3rem; color: var(--faint); font-size: .75rem; line-height: 1.3; }
  .gate__dot { display: none; }
  .js .gate__svg { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .js .gate__dot { display: block; position: absolute; width: 1.15rem; height: .5rem; background: var(--ink-3); box-shadow: 0 0 0 1px var(--line-3); transform: skewX(var(--skew)); transition: background-color .25s, box-shadow .25s; }
  .js [data-node].lit .gate__dot { background: var(--lime); box-shadow: 0 0 14px rgb(198 244 50 / .6); }
  .js [data-node].wait .gate__dot { background: var(--warn); box-shadow: 0 0 16px rgb(251 191 36 / .7); }
  .js [data-node] { position: relative; transition: opacity .25s; }
  .js [data-node] b { transition: color .25s; }
  .js [data-node].lit b { color: var(--lime); }
  .js [data-node].wait b { color: var(--warn); }
  .gate__rails path { fill: none; stroke: var(--line-3); stroke-width: 1.25; }
  .gate__trail { fill: none; stroke: var(--lime); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .85; }
  .gate__pulse { fill: var(--lime); opacity: 0; filter: drop-shadow(0 0 7px var(--lime)); }
  .gate__map.is-wait .gate__pulse { fill: var(--warn); filter: drop-shadow(0 0 9px var(--warn)); }
  .gate__map.is-wait .gate__trail { stroke: var(--warn); }

  @media (min-width: 900px) {
    .js .gate__map { --dy: 9.25rem; padding-top: 1.5rem; }
    .js .gate__nodes { grid-template-columns: repeat(9, minmax(0, 1fr)); grid-template-rows: var(--dy) auto; gap: 0 .75rem; }
    /* The route starts low, and the fork climbs along the slash: two parallel edges of one parallelogram. */
    .js [data-node] { grid-row: 2; padding-top: 1.35rem; }
    .js [data-node='approve'], .js [data-node='backup'], .js [data-node='run'], .js [data-node='redact'], .js [data-node='audit'] { grid-row: 1; align-self: start; }
    .js [data-node='approve'] { grid-column: 5; } .js [data-node='backup'] { grid-column: 6; } .js [data-node='run'] { grid-column: 7; } .js [data-node='redact'] { grid-column: 8; } .js [data-node='audit'] { grid-column: 9; }
    .js .gate__dot { left: .1rem; top: -.25rem; }
    .gate__txt code { font-size: .7rem; }
  }
  @media (max-width: 899px) {
    .js .gate__routes { grid-template-columns: 1fr; }
    .js .gate__routes li { display: contents; }
    .js .gate__pick { grid-row: auto; }
    .js .gate__result { grid-row: 4; }
    .js .gate__map { --lane: 2.6rem; padding-left: calc(var(--lane) + 1.75rem); padding-top: 1rem; }
    .js .gate__nodes { gap: 1.45rem; }
    .js .gate__dot { left: calc(-1.75rem - var(--lane) - .1rem); top: .35rem; }
    .js [data-node='approve'] .gate__dot, .js [data-node='backup'] .gate__dot, .js [data-node='run'] .gate__dot, .js [data-node='redact'] .gate__dot, .js [data-node='audit'] .gate__dot { left: calc(-1.75rem - var(--lane) - .1rem); }
    .js [data-node='who'] .gate__dot, .js [data-node='role'] .gate__dot, .js [data-node='place'] .gate__dot, .js [data-node='person'] .gate__dot { left: calc(-1.75rem - .1rem); }
  }

  .never { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 5vw, 6rem); margin-top: clamp(5rem, 11vw, 10rem); }
  .never .d2 { font-size: clamp(2.25rem, 4.2vw, 5rem); }
  .never__list { font: 700 clamp(1.625rem, 3.1vw, 3.75rem)/1.06 var(--display); letter-spacing: -.03em; }
