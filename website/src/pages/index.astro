    .answer__sk i:nth-child(1) { width: 96%; } .answer__sk i:nth-child(2) { width: 88%; } .answer__sk i:nth-child(3) { width: 93%; } .answer__sk i:nth-child(4) { width: 58%; }
    .motion .answer__sk i { animation: look 1.6s linear infinite; }
