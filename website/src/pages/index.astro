  .js .gate__routes li { display: contents; }
  .js .gate__pick { position: relative; grid-row: 1; padding-block: .6rem; color: var(--muted); cursor: pointer; transition: color .2s; }
  .js .gate__pick::after { content: ''; position: absolute; left: .1em; bottom: 0; width: 1.6rem; height: .32rem; background: var(--lime); transform: skewX(var(--skew)) scaleX(0); transform-origin: left; transition: transform .35s var(--ease); }
  .js .gate__pick:hover { color: var(--text); }
