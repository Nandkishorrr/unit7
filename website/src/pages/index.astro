  .card dl div:last-child dt::before { background: var(--ok); }
  .card__btns { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-top: .9rem; }
  .pill { display: grid; place-items: center; min-height: 2.5rem; border: 1px solid var(--line-2); border-radius: 999px; font-size: .9375rem; font-weight: 500; }
  .pill--blue { border-color: transparent; background: var(--product-blue); color: #fff; }
  .receipt { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .65rem; font-size: .9375rem; }
  .receipt svg { flex: none; width: 1.5rem; height: 1.5rem; padding: .25rem; border-radius: 50%; color: var(--ok); background: rgb(74 222 128 / .14); }
  .receipt__undo { color: var(--soft-blue); font-weight: 500; }
  .demo__cap { margin-top: 1.25rem; color: var(--faint); font-size: .8125rem; }

  @media (min-width: 900px) {
    .motion .demo { height: 520svh; padding: 0; }
    .motion .demo__stage { position: sticky; top: 0; display: flex; flex-direction: column; justify-content: center; height: 100svh; }
    .motion .demo__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(2rem, 4.5vw, 5.5rem); align-items: stretch; }
    /* Heading at the card's top edge, the beat in the middle, the ticks on its bottom edge: nothing floats. */
