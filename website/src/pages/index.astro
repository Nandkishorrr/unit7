  /* Autonomy */
  .auto__sub { margin-top: 1.25rem; }
  .auto__row { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .levels { flex: 1 1 34rem; max-width: 46rem; }
  .levels__track { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: .25rem; padding: .3rem; border: 1px solid var(--line-2); border-radius: 999px; background: var(--ink-1); }
  .levels__pill { position: absolute; inset: .3rem auto .3rem .3rem; width: calc((100% - .6rem - 1rem) / 5); border-radius: 999px; background: #F2F2F4; transform: translateX(calc(var(--at, 3) * (100% + .25rem))); transition: transform .42s var(--ease); }
  .levels__track:has(label:nth-of-type(1) input:checked) { --at: 0; }
  .levels__track:has(label:nth-of-type(2) input:checked) { --at: 1; }
  .levels__track:has(label:nth-of-type(3) input:checked) { --at: 2; }
  .levels__track:has(label:nth-of-type(4) input:checked) { --at: 3; }
  .levels__track:has(label:nth-of-type(5) input:checked) { --at: 4; }
  .levels label { position: relative; cursor: pointer; }
  .levels input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .levels label span { display: grid; place-items: center; min-height: 2.75rem; padding-inline: .25rem; border-radius: 999px; color: var(--muted); font-size: clamp(.8125rem, .78rem + .22vw, 1rem); font-weight: 500; text-align: center; transition: color .25s, background-color .25s; }
  .levels label:has(~ label input:checked) span { background: rgb(47 102 255 / .2); color: var(--soft-blue); }
  .levels label:has(input:checked) span { color: #0E0E12; font-weight: 600; }
  .levels label:hover:not(:has(input:checked)) span { color: var(--text); }
