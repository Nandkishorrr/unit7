    .motion .chat__part { order: 0; padding: 0; border: 0; background: none; border-radius: 0; }
    .motion .chat__a { position: relative; }
    .motion .bubble__t { font-size: 1em; }
    .motion .step { font-size: .94em; }
    .motion .answer { font-size: 1em; }
    .motion .answer__sk { display: grid; gap: .8em; position: absolute; inset: 4.2em 0 auto; }
