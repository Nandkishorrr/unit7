  /* The demo. Without motion (and on a phone) the beats stack: text, then its part of the chat. */
  .demo { position: relative; padding-block: clamp(4rem, 9vw, 7rem); }
  .demo__grid { display: flex; flex-direction: column; gap: 1.5rem; }
