  .demo__ticks, .chat__top, .chat__input, .chat__glance, .chat__wait > h4, .chat__none, .answer__sk { display: none; }
  .chat__part { padding: 1.1rem; border: 1px solid var(--line); border-radius: 22px; background: var(--ink-2); }
  .bubble { display: flex; justify-content: flex-end; }
