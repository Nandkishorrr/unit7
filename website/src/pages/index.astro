    .motion .card dd { display: inline; }
    .motion .card__btns { margin-top: .7em; }
    .motion .pill { min-height: 2.3em; font-size: .92em; }
    .motion .chat__r { margin-top: .5em; padding: .75em .85em; border-radius: 14px; background: var(--ink-3); }
    .motion .receipt { font-size: .92em; line-height: 1.35; }
