---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Code from '../components/Code.astro';
import Updates from '../components/Updates.astro';
import RealUse from '../components/RealUse.astro';
import Environments from '../components/Environments.astro';
import TalkToMap from '../components/TalkToMap.astro';
import logos from '../data/logos.json';
import map from '../assets/screens/map.png';
import coolify from '../assets/screens/coolify.png';
import projects from '../assets/screens/projects.png';
import connections from '../assets/screens/connections.png';
import autopilot from '../assets/screens/autopilot.png';
import routines from '../assets/screens/routines.png';
import { REPO_URL } from '../site';

const panels = [
  { img: map, title: 'The Map.', line: 'Every domain, the app behind it and the database behind that, across all your providers. Anything pointing the wrong way shows up red.', alt: 'The Map: domains on the left, apps and databases on the right, joined by lines. One dashed red line marks a domain pointing elsewhere.' },
  { img: coolify, title: 'Inside Coolify.', line: 'It finds every project, domain, database and cron job from Docker labels, with zero setup. Coolify stays in charge.', alt: 'The server page for vps-01, showing the projects it found inside Coolify, each with its domains.' },
  { img: projects, title: 'Projects.', line: 'Production, staging and dev side by side. A new version takes traffic only after it passes a health check. One click to go back.', alt: 'Project cards for shipfast, nestly, playground and scratch, each with its environments and recent deploys.' },
  { img: connections, title: 'Connections.', line: 'One click per provider. Your keys stay encrypted on your machine. The AI only ever sees a reference, never the key.', alt: 'The Connections page: your AI at the top, then tiles for hosting providers such as Hostinger, Vercel and Netlify.' },
  { img: autopilot, title: 'Autopilot.', line: 'Pick how much it does alone, per environment. Hold one button to pause everything.', alt: 'The Autopilot page: a Hold to pause everything button, and a level picker for production, staging and development.' },
  { img: routines, title: 'Routines.', line: '"Every Monday at 9, send me a health report." Same approvals as when you ask.', alt: 'The Routines page: a list of scheduled jobs, each with when it last worked and when it runs next.' },
];

const specs = [
  ['Deploys.', 'Any app from a git repo or a folder: Next, Vite, Node, FastAPI, Django, Go, Rust, PHP, static or Docker.'],
  ['Databases.', 'Postgres, MySQL, Redis and Mongo as private containers. The password goes in the vault, the address goes in your app.'],
  ['Domains and HTTPS.', '<code>point app.example.com at production</code> sets the DNS, the route and the certificate.'],
  ['Backups.', 'Encrypted, copied off the server, with scheduled test restores so you know they work.'],
  ['Warden.', 'A guard with no AI in the loop. It restarts what crashed, rolls back bad deploys and blocks scanners. When a disk fills up, it asks you.'],
  ['Security.', 'SSH keys only, a firewall, automatic security updates, IP blocking and a full audit trail.'],
  ['Put a site live.', 'Drop a folder or a ZIP, or pick a GitHub repo. It picks the best host you have connected, from 16.'],
  ['Your real databases.', 'Tables, safe queries, import and export on any Postgres, MySQL, MariaDB, Redis or MongoDB it finds on your server.'],
  ['Files and server care.', 'Browse and edit files, take snapshots, open ports, manage SSH keys and users, and move to a new server.'],
  ['WordPress, Supabase, Neon.', 'Plugins and new sites on your server. Projects, SQL, auth, storage and logs, hosted or self-hosted.'],
  ['One-click tools.', 'More than 30 open-source tools, with the admin login claimed before anyone else can reach it.'],
];

const nodes = [
  ['who', "Who's asking?", 'tenant check'],
  ['role', 'Are they allowed?', 'role'],
  ['place', 'What does this place allow?', 'environment policy'],
  ['person', 'Does it need a person?', ''],
  ['approve', 'Approval', 'web or phone'],
  ['backup', 'Backup first', 'if destructive'],
  ['run', 'Run', 'secrets resolved here only'],
  ['redact', 'Hide secrets', 'redact'],
  ['audit', 'Write it down', 'audit'],
];

const routes = [
  ['read', 'Read the logs.', 'Read-only. It runs right away.'],
  ['restart', 'Restart the app.', 'Reversible. At Fix itself it just happens, with an undo.'],
  ['delete', 'Delete a database.', 'Waits for a person. A backup comes first.'],
];

const levels = [
  { name: 'Watch', line: 'Unit 7 watches and tells you. It changes nothing.' },
  { name: 'Suggest', line: 'Unit 7 suggests each fix. You say yes to every one.' },
  { name: 'Ask first', line: 'Small, safe fixes happen on their own. Anything that touches your live app waits for you.' },
  { name: 'Fix itself', line: 'Unit 7 keeps your live app running by itself. Deleting things and other risky steps wait for you.', rec: 'Recommended for production' },
  { name: 'Autopilot', line: "Unit 7 does it all. Only spending money and things you've ruled out wait for you.", rec: 'Recommended for test copies' },
];

const row1 = ['coolify', 'docker', 'hostinger', 'cloudflare', 'vercel', 'netlify', 'render', 'railway', 'fly', 'heroku', 'digitalocean', 'hetzner', 'gcp', 'firebase', 'aws', 'azure'];
const row2 = ['supabase', 'neon', 'postgres', 'mysql', 'redis', 'mongodb', 'github', 'claude', 'cursor', 'windsurf', 'codex', 'antigravity'];
const names: Record<string, string> = { coolify: 'Coolify', docker: 'Docker', hostinger: 'Hostinger', cloudflare: 'Cloudflare', vercel: 'Vercel', netlify: 'Netlify', render: 'Render', railway: 'Railway', fly: 'Fly.io', heroku: 'Heroku', digitalocean: 'DigitalOcean', hetzner: 'Hetzner', gcp: 'Google Cloud', firebase: 'Firebase', aws: 'AWS', azure: 'Azure', supabase: 'Supabase', neon: 'Neon', postgres: 'PostgreSQL', mysql: 'MySQL', redis: 'Redis', mongodb: 'MongoDB', github: 'GitHub', claude: 'Claude', cursor: 'Cursor', windsurf: 'Windsurf', codex: 'Codex', antigravity: 'Antigravity' };
const logo = (k: string) => (logos as Record<string, { w: number; h: number; body: string; mono?: boolean }>)[k];

const install = `git clone ${REPO_URL}.git && cd unit7
npm install
npm run build
node bin/unit7.mjs serve`;
---
<Base
  title="Unit 7 by Signull: the backend developer your AI coding agent never had"
  description="Unit 7 is a free, open-source control room for your servers, apps, domains, databases and backups. Talk to it in plain words. It does the work, and asks before anything risky."
>
  <svg class="works__sprite" aria-hidden="true" width="0" height="0">
    <defs>
      {[...row1, ...row2].map((k) => <symbol id={`l-${k}`} viewBox={`0 0 ${logo(k).w} ${logo(k).h}`} set:html={logo(k).body} />)}
    </defs>
  </svg>

  <section class="hero" data-mood="night" data-power="1">
    <div class="hero__pin">
      <svg class="hero__seven" viewBox="5 6 22 20" aria-hidden="true">
        <path d="M17.11 12.15h5.6L14.9 24.75H9.3z" fill="#C6F432" />
        <path d="M9.45 7.25h16.3l-3.22 5.2H6.23z" fill="#3D73FF" />
      </svg>
      <div class="hero__copy wrap">
        <p class="eyebrow" data-intro>Open source · Self-hosted · Apache 2.0</p>
        <h1 class="d1" data-intro>The backend developer your AI coding agent <em>never had.</em></h1>
        <p class="lede" data-intro>Talk to it in plain words. It does the work on your real servers, and asks before anything risky.</p>
        <div class="cta" data-intro>
          <a class="btn" href="/open-source/#install">Get Unit 7</a>
          <a class="btn btn--ghost" href="#film">Watch the 60-second film</a>
        </div>
        <p class="small" data-intro>Unit 7 is early. Expect rough edges.</p>
      </div>
    </div>
  </section>

  <section class="problem sec" data-mood="alert">
    <div class="wrap">
      <h2 class="d1" data-wipe>AI writes the code in minutes. <em>Everything after that still eats your evenings.</em></h2>
      <ul class="problem__list">
        <li>The VPS.</li>
        <li>The Coolify stacks.</li>
        <li>DNS spread over three providers.</li>
        <li>Backups you hope work.</li>
        <li>The port you forgot was open.</li>
      </ul>
    </div>
  </section>

  <section class="film sec" id="film" data-mood="night">
    <div class="wrap">
      <h2 class="d1" data-wipe>Your AI writes the code. <em>Unit&nbsp;7 runs the rest.</em></h2>
      <figure class="film__box">
        <video id="filmv" controls preload="none" playsinline width="1920" height="1080" poster="/film/poster.jpg" aria-label="The Unit 7 launch film, 60 seconds, with a voiceover.">
          <source src="/film/unit7-launch.mp4" type="video/mp4" />
        </video>
        <button class="btn film__play" type="button" hidden>Play with sound</button>
      </figure>
      <p class="mock-label">60 seconds. Demo workspace.</p>
    </div>
  </section>

  <RealUse />

  <section class="demo" id="demo" data-mood="night">
    <div class="demo__stage">
      <div class="wrap demo__grid">
        <div class="demo__left">
          <h2 class="d2">Ask. It looks. It asks. <em>You decide.</em></h2>
          <ol class="demo__texts">
            <li style="--o:1"><h3 class="d3">Ask in plain words.</h3><p>No dashboards to learn. Say it the way you'd say it to a person.</p></li>
            <li style="--o:3"><h3 class="d3">It looks at the real thing.</h3><p>Your logs, your deploys, your database. Then it tells you what it found.</p></li>
            <li style="--o:5"><h3 class="d3">It asks before anything risky.</h3><p>Every risky step says what it will do and how to undo it. Nothing happens until you say yes.</p></li>
            <li style="--o:7"><h3 class="d3">You keep the undo.</h3><p>It does the work, checks the app is healthy and writes it all down.</p></li>
          </ol>
          <div class="demo__ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="chat">
          <div class="chat__top" aria-hidden="true">
            <img src="/brand/unit7-mark.svg" width="22" height="22" alt="" />
            <span>Unit 7</span>
            <span class="chat__where">nestly · Production</span>
          </div>
          <div class="chat__main">
            <div class="chat__part chat__q" style="--o:2">
              <p class="bubble"><span class="sr">Why do some listing pages crash since this morning?</span><span class="bubble__t" aria-hidden="true">Why do some listing pages crash since this morning?</span></p>
            </div>
            <div class="chat__part chat__a" style="--o:4">
              <div class="step">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3.5 8.5 6.6 11.6 12.5 5" /></svg>
                <span>Errors, in plain words</span>
                <code>38ms</code>
              </div>
              <div class="answer__sk" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
              <p class="answer">Deploy #42 of web reads <code>listing.city</code>, but listings created before the September import have no address yet, so those pages throw <code>TypeError: Cannot read properties of null (reading 'city')</code> (37 times so far). The fix is a null check in app/listings/[id]/page.tsx:42. Want me to roll production back to #41 while I fix it?</p>
            </div>
            <div class="chat__input" aria-hidden="true">Reply to Unit 7…</div>
          </div>
          <div class="chat__side">
            <div class="chat__glance" aria-hidden="true">
              <h4>At a glance</h4>
              <ul>
                <li><span>Apps<small><i class="dot dot--bad"></i>2 need a look</small></span><b>11</b></li>
                <li><span>Servers<small><i class="dot dot--ok"></i>All good</small></span><b>1</b></li>
                <li><span>Domains<small><i class="dot dot--bad"></i>4 need a look</small></span><b>7</b></li>
              </ul>
            </div>
            <div class="chat__wait">
              <h4 aria-hidden="true">Waiting for you</h4>
              <p class="chat__none" aria-hidden="true">Nothing happens until you say yes.</p>
              <div class="chat__part chat__c" style="--o:6">
                <div class="card">
                  <h4>Go back to the previous version</h4>
                  <p class="card__meta">Production</p>
                  <dl>
                    <div><dt>It will:</dt><dd>The app goes back to the version before this one.</dd></div>
                    <div><dt>To undo:</dt><dd>Deploy the newer version again from the app's page.</dd></div>
                  </dl>
                  <div class="card__btns" aria-hidden="true"><span class="pill">Not now</span><span class="pill pill--blue">Approve</span></div>
                </div>
              </div>
              <div class="chat__part chat__r" style="--o:8">
                <p class="receipt">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3.5 8.5 6.6 11.6 12.5 5" /></svg>
                  <span>nestly · web is back on #41. Health check passed.</span>
                  <span class="receipt__undo">Undo</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="demo__cap wrap mono">Demo workspace. Numbers are examples.</p>
    </div>
  </section>

  <Environments />

  <TalkToMap />

  <section class="gallery" data-mood="night">
    <div class="gallery__stage">
      <div class="gallery__track">
        <header class="gallery__intro">
          <h2 class="d1">Everything after <em>the code.</em></h2>
        </header>
        {panels.map((p, i) => (
          <article class="shot">
            <header class="shot__head">
              <p class="shot__n mono">0{i + 1} / 06</p>
              <h3 class="shot__title">{p.title}</h3>
              <p class="shot__line">{p.line}</p>
            </header>
            <div class="shot__frame">
              <Picture class="shot__img" src={p.img} formats={['avif', 'webp']} fallbackFormat="png" widths={[720, 1080, 1440, 2160]} sizes="(min-width: 900px) min(74vw, 1500px), 86vw" alt={p.alt} loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
      </div>
      <div class="gallery__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="specs sec">
    <dl class="wrap specs__list">
      {specs.map(([label, line]) => <div><dt class="d3">{label}</dt><dd set:html={line} /></div>)}
    </dl>
    <p class="wrap small specs__note">The last five are new since V2.1 and still in testing. <a href="/v2/#new">See where each one stands.</a></p>
  </section>

  <section class="gate sec" data-mood="deep" data-warden="I ask before anything risky.">
    <div class="wrap">
      <h2 class="d2" data-wipe>Every action goes through <em>one gate.</em></h2>
      <p class="lede lede--wide gate__sub">The web app, the command line, your AI agent and Unit 7 itself all pass the same checks. A read-only token can only read. Anything risky still needs you.</p>

      <ul class="gate__routes">
        {routes.map(([id, label, result], i) => (
          <li class:list={[{ on: i === 0 }]}>
            <button class="gate__pick" type="button" data-route={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
            <p class="gate__result">{result}</p>
          </li>
        ))}
      </ul>

      <div class="gate__map">
        <svg class="gate__svg" aria-hidden="true"><g class="gate__rails"></g><path class="gate__trail" /><circle class="gate__pulse" r="6" /></svg>
        <ol class="gate__nodes">
          {nodes.map(([id, label, tech]) => (
            <li data-node={id}>
              <i class="gate__dot"></i>
              <span class="gate__txt"><b>{label}</b>{tech && <code>{tech}</code>}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="never">
        <h3 class="d2" data-wipe>Five things it never does on its own.</h3>
        <ol class="never__list">
          <li>Destroy data.</li>
          <li>Delete servers, volumes or backups.</li>
          <li>Leak a secret.</li>
          <li>Spend past a cap.</li>
          <li>Raise its own autonomy.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="auto sec" id="autonomy">
    <div class="wrap">
      <h2 class="d2" data-wipe>You pick <em>how brave it is.</em></h2>
      <p class="lede auto__sub">Per environment. Spending money always waits for you.</p>

      <div class="auto__row">
        <fieldset class="levels">
          <legend class="sr">How much Unit 7 does alone</legend>
          <div class="levels__track">
            <span class="levels__pill" aria-hidden="true"></span>
            {levels.map((l, i) => (
              <label class:list={[{ rec: l.rec }]}>
                <input type="radio" name="level" value={i} checked={i === 3} />
                <span>{l.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="hold">
          <button class="holdbtn" id="hold" type="button">
            <span class="holdbtn__fill" aria-hidden="true"></span>
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="3.5" y="2.5" width="3.4" height="11" rx="1" /><rect x="9.1" y="2.5" width="3.4" height="11" rx="1" /></svg>
            <span class="holdbtn__t">Hold to pause everything</span>
          </button>
        </div>
      </div>

      <div class="says" aria-live="polite">
        {levels.map((l, i) => (
          <div class="says__one" data-l={i}>
            <p class="says__line">{l.line}</p>
            {l.rec && <p class="says__rec"><i></i>{l.rec}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="proof__gate">
      <div class="proof__open" data-open>
        <div class="wrap proof__ask">
          <p class="eyebrow">A real run on our own server · 5 November 2026</p>
          <h2 class="d1">We asked it three things.</h2>
          <ol class="proof__qs">
            <li>Is the server using too much, and how do we reduce it?</li>
            <li>Is there a security issue right now?</li>
            <li>What's wrong or repeated in how my apps behave?</li>
          </ol>
        </div>
      </div>
    </div>
    <div class="proof__rest" data-opaque data-warden="95 seconds. Not bad.">
      <div class="wrap">
        <dl class="proof__nums">
          <div><dt>seconds</dt><dd class="num" data-count="95">95</dd></div>
          <div><dt>tool calls</dt><dd class="num" data-count="16">16</dd></div>
          <div><dt>real problems found</dt><dd class="num" data-count="11">11</dd></div>
        </dl>
        <div class="proof__found">
          <h3 class="d3">What it found:</h3>
          <ul>
            <li>A sync loop that ignored its own 15-minute wait</li>
            <li><code>/auth/v1/user</code> called 6,625 times in 7 days</li>
            <li>An outside service refusing every call with a 403</li>
            <li>One request per item where one call would do</li>
          </ul>
        </div>
        <p class="proof__end d2">Then a Docker cleanup and a closed port, in two clicks.</p>
      </div>
    </div>
  </section>

  <section class="works sec" data-mood="night">
    <div class="wrap">
      <h2 class="d2" data-wipe>Sits next to <em>what you already use.</em></h2>
      <p class="lede lede--wide works__sub">Coolify runs your apps. Unit 7 watches Coolify, your domains, your backups and your AI agents.</p>
    </div>
    <div class="works__rows">
      {[row1, row2].map((row, r) => (
        <div class:list={['marq', { 'marq--back': r === 1 }]}>
          <div class="marq__track">
            {[0, 1].map((copy) => (
              <ul aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map((k) => (
                  <li title={names[k]} data-k={k}>
                    <svg style={`aspect-ratio:${logo(k).w}/${logo(k).h}`} role="img" aria-label={names[k]}><use href={`#l-${k}`} /></svg>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="wrap works__line">Your AI coding agent connects over MCP. Same gate, same approvals. Or add an API key. AI is optional.</p>
  </section>

  <section class="teaser sec" data-mood="dawn">
    <div class="wrap">
      <p class="eyebrow">V2.1</p>
      <p class="d1 teaser__big" data-wipe>V1 does the job when you ask. <em>V2 has already done it when you open the app.</em></p>
      <p class="lede lede--wide teaser__sub">V2.1 adds Seven, an agent on shift. It does the safe work and asks one clear question.</p>
      <div class="cta"><a class="btn" href="/v2/">See what's in V2.1</a></div>
    </div>
  </section>

  <section class="close sec" data-mood="night">
    <div class="wrap close__grid">
      <div>
        <h2 class="d1" data-wipe>Free. Open source. <em>Yours.</em></h2>
        <p class="lede">One Node process and one SQLite file. Apache 2.0.</p>
        <div class="cta"><a class="btn" href="/open-source/#install">Full setup guide</a></div>
        <Updates />
      </div>
      <div>
        <Code code={install} label="Install" wrap />
        <p class="small close__needs">Needs Node 24.22 or newer, on macOS or Linux.</p>
      </div>
    </div>
  </section>
</Base>

<script src="../scripts/home.ts"></script>

<style is:global>
  /* Hero: the 7 is drawn by the shader. The copy sits in its counter. */
  .hero { position: relative; }
  .hero__pin { position: relative; display: flex; align-items: flex-end; min-height: 100svh; overflow: clip; padding-block: 5.5rem clamp(2rem, 6vh, 4.5rem); }
  /* Ribbons drift, so the words get a little shade of their own. It leaves with them on scroll. */
  .hero__pin::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: var(--scrim, 1); background: linear-gradient(90deg, rgb(5 5 6 / .66), rgb(5 5 6 / .4) 34%, transparent 58%); }
  .hero__copy { position: relative; display: grid; gap: clamp(1rem, 2.4vh, 1.75rem); }
  .hero .small { color: var(--muted); }
  .hero .d1 { max-width: 9.6em; }
  .hero .lede { max-width: 31ch; }
  .hero__seven { display: none; position: absolute; right: -4vw; bottom: -6vh; width: auto; height: 100vh; }
  html:not(.js) .hero__seven, .nogl .hero__seven { display: block; }
  .motion [data-intro] { visibility: hidden; }
  @media (min-width: 900px) {
    .motion .hero { height: 240svh; }
    .motion .problem { margin-top: -50svh; }   /* the headline rises as the 7 leaves, no empty screen between them */
    .motion .hero__pin { position: sticky; top: 0; height: 100svh; }
  }
  @media (max-width: 899px) {
    .hero__seven { right: 50%; top: 5.5rem; bottom: auto; height: 27vh; transform: translateX(50%); }
    .hero__pin { padding-top: 34svh; }
    .hero__pin::before { background: linear-gradient(to top, rgb(5 5 6 / .72) 34%, transparent 66%); }
    .hero__copy { gap: .9rem; }
    .hero .d1 { font-size: clamp(2.5rem, 12.2vw, 4.25rem); }
    .hero .cta { flex-direction: column; align-items: stretch; }
    .hero .eyebrow { font-size: clamp(.625rem, 2.9vw, .75rem); letter-spacing: .06em; white-space: nowrap; }
  }

  /* The problem: the list leans the same way as the 7 */
  @media (min-width: 900px) { .problem { padding-top: clamp(1.5rem, 2.5vw, 3rem); } }
  .problem .d1 { max-width: 13em; }
  .problem__list { --lh: clamp(2.6rem, 6vw, 7rem); margin-top: clamp(4rem, 9vw, 9rem); margin-left: auto; width: fit-content; font: 680 clamp(1.75rem, 4.7vw, 5.5rem)/var(--lh) var(--display); font-stretch: 100%; letter-spacing: -.03em; }
  .problem__list li { margin-left: calc((4 - var(--i, 0)) * var(--lh) * var(--slash)); white-space: nowrap; }
  .problem__list li:nth-child(1) { --i: 0; } .problem__list li:nth-child(2) { --i: 1; } .problem__list li:nth-child(3) { --i: 2; } .problem__list li:nth-child(4) { --i: 3; } .problem__list li:nth-child(5) { --i: 4; }
