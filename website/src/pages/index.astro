  .film__box { position: relative; margin-top: clamp(2rem, 4vw, 3.5rem); overflow: hidden; border: 1px solid var(--line-2); border-radius: clamp(14px, 2vw, 28px); background: var(--ink-0); box-shadow: 0 50px 100px -60px #000; }
