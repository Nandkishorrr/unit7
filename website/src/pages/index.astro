    .motion .chat__input { display: flex; align-items: center; flex: none; min-height: 3.1em; margin-top: auto; padding-inline: 1.1em; border: 1px solid var(--line-2); border-radius: 16px; color: var(--faint); font-size: .94em; }
    .motion .chat__side { display: flex; flex-direction: column; gap: .75em; min-height: 0; padding: 1em; border-left: 1px solid var(--line); background: var(--ink-1); }
    .chat__side h4 { font-size: .94em; font-weight: 600; }
