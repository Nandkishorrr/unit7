    .gallery__stage { padding-top: 13rem; }
  }
  @media (min-width: 900px) {
    .gallery { --pw: min(70vw, (100vh - 15rem) * 1.6); --gap: 5vw; --intro: 40vw; }
    .gallery__track { flex-wrap: nowrap; align-items: center; width: max-content; padding-inline: var(--gut); }
    .gallery__intro { width: var(--intro); padding: 0; margin: 0; }
    .gallery__intro .d1 { font-size: clamp(3.75rem, 7.4vw, 9rem); }
    .shot__head { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 2.5rem; align-items: end; }
    .shot__n { grid-column: 1 / -1; }
    .shot__title { font-size: clamp(2.5rem, 3.9vw, 4.75rem); white-space: nowrap; }
    .shot__line { margin: 0 0 .15rem; justify-self: end; max-width: 50ch; font-size: clamp(.9375rem, .9rem + .2vw, 1.0625rem); }
    html:not(.motion) .gallery__track { flex-wrap: wrap; width: auto; }
    html:not(.motion) .gallery__intro { width: 100%; margin-bottom: 2rem; }
    html:not(.motion) .shot { flex: 1 1 100%; max-width: 62rem; }

    .motion .gallery { height: calc(100vh + var(--intro) + 6 * var(--pw) + 6 * var(--gap) + 2 * var(--gut) - 100vw); padding: 0; }
    .motion .gallery__stage { position: sticky; top: 0; height: 100vh; overflow: clip; }
    .motion .gallery__track { height: 100%; will-change: transform; }
    .motion .gallery__bar { position: absolute; left: var(--gut); bottom: 1.2rem; display: block; width: 14rem; height: .42rem; background: var(--line-2); transform: skewX(var(--skew)); }
    .gallery__bar i { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: left; }
    .motion .shot__frame { --k: calc(var(--pw) / 1.6 * var(--slash)); clip-path: polygon(0 0, calc((100% + var(--k)) * var(--p, 1)) 0, calc((100% + var(--k)) * var(--p, 1) - var(--k)) 100%, 0 100%); }
    .motion .shot__img { scale: 1.035; }
