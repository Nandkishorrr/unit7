  /* The specs list */
  .specs { padding-top: clamp(4rem, 9vw, 8rem); }
  .specs__list > div { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: .5rem 2rem; padding-block: clamp(1rem, 2vw, 1.6rem); border-top: 1px solid var(--line-2); align-items: baseline; }
  .specs__list > div:last-child { border-bottom: 1px solid var(--line-2); }
  .specs__list dd { color: var(--muted); max-width: 56ch; }
  .specs__list dd code { color: var(--text); }
  @media (max-width: 899px) { .specs__list > div { grid-template-columns: 1fr; } }

  /* One gate */
  .gate__sub { margin-top: 1.5rem; }
  .gate__routes { margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; gap: 1rem; }
  .gate__pick { display: block; padding: 0; border: 0; background: none; font: 680 clamp(1.25rem, 1.9vw, 1.75rem)/1.1 var(--display); letter-spacing: -.02em; text-align: left; }
  .gate__result { color: var(--muted); }
