  /* Gallery. Default: a native snap carousel. With motion on a desktop: pinned, moved sideways by the scroll. */
  .gallery { --pw: 86vw; --gap: 1rem; position: relative; padding-block: clamp(3rem, 7vw, 5rem); }
  .gallery__intro { flex: none; width: 100%; padding-inline: var(--gut); margin-bottom: 1.5rem; }
  .gallery__intro .d1 { font-size: clamp(2.75rem, 11vw, 5rem); max-width: 7em; }
  .gallery__track { display: flex; flex-wrap: wrap; gap: var(--gap); }
  .gallery__stage { position: relative; }
  .shot { flex: 0 0 var(--pw); scroll-snap-align: center; display: grid; gap: 1rem; align-content: start; }
  .gallery__bar { display: none; }
  .shot__n { color: var(--faint); font-size: .8125rem; }
  .shot__title { margin-top: .25rem; font: 740 clamp(2rem, 8vw, 3rem)/1 var(--display); font-stretch: 103%; letter-spacing: -.03em; }
  .shot__line { margin-top: .5rem; color: var(--muted); font-size: 1rem; line-height: 1.45; max-width: 46ch; }
  .shot__frame { overflow: hidden; aspect-ratio: 16 / 10; border: 1px solid var(--line-2); border-radius: 16px; background: var(--ink-1); }
